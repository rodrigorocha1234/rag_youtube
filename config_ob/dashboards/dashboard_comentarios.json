{
  "uid": "rag-comentarios-youtube",
  "title": "RAG de Comentários do YouTube",
  "description": "Snapshots do pipeline e exemplos sintéticos de avaliação. Métricas ausentes não equivalem a zero.",
  "id": null,
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "tags": [
    "rag",
    "youtube",
    "avaliacao"
  ],
  "timezone": "America/Sao_Paulo",
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Como ler o painel",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Este painel exibe **snapshots por execução**: as contagens reiniciam a cada execução do pipeline e o exportador mantém o último arquivo. Não são taxas de um serviço contínuo. **Sem dados** significa que a série não foi publicada; não comprova contagem zero. O dataset JSONL é referência sintética e não gera scores automaticamente. Execute o pipeline descrito em docs/guia_uso.md para publicar métricas reais."
      }
    },
    {
      "id": 2,
      "title": "Exportador disponível",
      "type": "stat",
      "description": "1: alvo alcançável; 0: scrape falhou. Não confirma execução do pipeline.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${fonte}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"$job\"}",
          "legendFormat": "{{etapa}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Séries RAG publicadas",
      "type": "stat",
      "description": "Quantidade de séries de contagem do namespace configurado. Ausente antes da primeira execução.",
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${fonte}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(${namespace}_eventos_total{job=\"$job\"})",
          "legendFormat": "{{etapa}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Comentários coletados",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${fonte}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "${namespace}_eventos_total{job=\"$job\",etapa=\"comentarios_coletados\"}",
          "legendFormat": "{{etapa}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Documentos indexados",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${fonte}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "${namespace}_eventos_total{job=\"$job\",etapa=\"documentos_indexados\"}",
          "legendFormat": "{{etapa}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "Contagens da última execução",
      "type": "bargauge",
      "description": "Bronze é contado em páginas; Prata/Ouro em registros. Quota e requisições são unidades distintas.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${fonte}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "${namespace}_eventos_total{job=\"$job\"}",
          "legendFormat": "{{etapa}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 7,
      "title": "Erros por etapa e tipo",
      "type": "bargauge",
      "description": "As séries de erro só são criadas quando há falhas; ausência não é uma medição publicada de zero.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${fonte}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "${namespace}_erros_total{job=\"$job\"}",
          "legendFormat": "{{etapa}} / {{tipo}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 8,
      "title": "Duração média por etapa no snapshot",
      "type": "bargauge",
      "description": "Média de observações da execução exportada. Não usa rate sobre contadores reiniciados.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${fonte}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (etapa) (${namespace}_latencia_segundos_sum{job=\"$job\"}) / sum by (etapa) (${namespace}_latencia_segundos_count{job=\"$job\"})",
          "legendFormat": "{{etapa}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 9,
      "title": "Contagens ao longo dos snapshots",
      "type": "timeseries",
      "description": "O mesmo snapshot é repetido a cada scrape até uma nova execução; cada ponto não representa novo evento.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${fonte}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "${namespace}_eventos_total{job=\"$job\",etapa=~\"comentarios_coletados|ouro|documentos_indexados\"}",
          "legendFormat": "{{etapa}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 10,
      "title": "Qualidade medida por critério",
      "type": "bargauge",
      "description": "Somente medições explicitamente publicadas. Não inferir groundedness factual do dataset ou de fontes retornadas.",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${fonte}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "${namespace}_qualidade{job=\"$job\"}",
          "legendFormat": "{{criterio}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 11,
      "title": "Dataset v1 — exemplos sintéticos",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 9
      },
      "options": {
        "mode": "markdown",
        "content": "**Arquivo de referência:** `avaliacoes/dataset_rag_v1.jsonl`\n\nOs exemplos abaixo são sintéticos. Respostas esperadas são gabaritos, não resultados de uma avaliação real. Esta prévia é atualizada ao regenerar o dashboard.\n\n| Pergunta | Resposta esperada | Evidências |\n|---|---|---|\n| Qual dificuldade foi relatada? | Dificuldade para instalar a biblioteca. | comentario_sintetico_1 |\n| Qual preço foi citado? | Não há evidências suficientes para informar o preço. | Sem contexto |\n\nPara avaliar: use AvaliadorGenai com scorers de retrieval, geração e completo; consulte os resultados e traces no MLflow. Nenhum score foi fabricado para preencher este painel."
      }
    },
    {
      "id": 12,
      "title": "Exemplo de resposta — ilustrativo",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 7
      },
      "options": {
        "mode": "markdown",
        "content": "**Exemplo fictício de resultado, sem execução do modelo ou coleta real.**\n\n**Pergunta:** Quais são as principais dúvidas nos comentários?\n\n**Resposta:** A dúvida apresentada é como instalar a biblioteca [comentario_sintetico_1].\n\n**Fonte ilustrativa:** [comentario_sintetico_1] Não consegui instalar a biblioteca. Como faço?\n\nA CLI retorna `resposta` e `fontes`, com IDs e metadados de proveniência. Sem evidências, retorna a mensagem configurada e `fontes: []`. Este exemplo não publica métricas nem scores de avaliação."
      }
    },
    {
      "id": 13,
      "title": "Respostas pela API MLflow /invocations",
      "type": "stat",
      "description": "Contagem real no processo de serving. Reinicia ao reiniciar o serviço.",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${fonte}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "${namespace_serving}_eventos_total{job=\"$job\",etapa=\"respostas_servidas\"}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Sem dados"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none"
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "fonte",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Namespace RAG",
        "type": "constant",
        "query": "rag_youtube",
        "current": {
          "text": "rag_youtube",
          "value": "rag_youtube"
        },
        "hide": 2
      },
      {
        "name": "job",
        "label": "Exportador",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${fonte}"
        },
        "definition": "label_values(up, job)",
        "query": {
          "query": "label_values(up, job)",
          "refId": "job"
        },
        "current": {
          "text": "ml_service",
          "value": "ml_service"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "namespace_serving",
        "label": "Namespace Serving",
        "type": "constant",
        "query": "rag_youtube_serving",
        "current": {
          "text": "rag_youtube_serving",
