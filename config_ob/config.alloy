discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_labels" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.process "extract_level" {
  forward_to = [loki.write.local_loki.receiver]

  stage.regex {
    expression = "(?i)(?P<level>DEBUG|INFO|WARN(?:ING)?|ERR(?:OR)?|CRIT(?:ICAL)?|FATAL|TRACE|NOTICE)"
  }

  stage.labels {
    values = {
      level = "",
    }
  }
}

loki.source.docker "docker_logs" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  forward_to    = [loki.process.extract_level.receiver]
  relabel_rules = discovery.relabel.docker_labels.rules
}

loki.write "local_loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Logs de pipelines executados no host (CLI Python).
local.file_match "pipeline_logs" {
  path_targets = [{
    __path__ = sys.env("RAG_LOG_GLOB"),
    job      = sys.env("RAG_LOG_JOB"),
  }]
}

loki.source.file "pipeline_logs" {
  targets    = local.file_match.pipeline_logs.targets
  forward_to = [loki.process.pipeline_logs.receiver]
}

loki.process "pipeline_logs" {
  forward_to = [loki.write.local_loki.receiver]

  stage.json {
    expressions = {
      nivel     = "nivel",
      aplicacao = "aplicacao",
    }
  }

  stage.labels {
    values = {
      level     = "nivel",
      aplicacao = "aplicacao",
    }
  }
}
